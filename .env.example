SAVEGATE_API_KEY=
SAVEGATE_BASE_URL=https://api.savegate.ai/v1
SAVEGATE_MODEL=gpt-5.4
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WEB_SEARCH_URL=http://127.0.0.1:8088
# Cloud deployment only: use the provisioned server environment; never commit values.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# SOURCE_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=
# INDEXING_MODE=vercel_queue
# WEB_SEARCH_PROVIDER=parallel_free
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Google OAuth: cấu hình ở server, callback /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_DATA_DIR=./data
RAG_SOURCE_PATH=./knowledge/originals/Tailieu_AI_Tong_hop.txt
PDF_SOURCE_DIR=./knowledge/originals
ADMIN_EMAIL=admin@academic.local
ADMIN_NAME=Quản trị viên
ADMIN_PASSWORD=
# Optional email recovery (use a real sender; never log reset links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Chỉ bật sau khi SMTP sẵn sàng và đã đánh giá tài khoản cũ chưa xác minh.
EMAIL_OTP_ENABLED=false
## Secret riêng cho cron dọn thùng rác trên Vercel; tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự.
CRON_SECRET=

# Model nhận diện âm thanh, dùng GEMINI_API_KEY ở máy chủ.
GEMINI_SPEECH_MODEL=gemini-2.5-flash-lite
