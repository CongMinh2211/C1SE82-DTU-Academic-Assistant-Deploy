{
  "name": "dtu-academic-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "configure": "node --import tsx scripts/configure.ts",
    "dev": "next dev FE",
    "build": "next build FE",
    "start": "next start FE",
    "setup": "node --import tsx scripts/handover/restore-local.mjs",
    "migrate": "node --env-file=.env.local --import tsx scripts/bootstrap.ts --migrate-only",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "test": "node --env-file=.env.local --import tsx --test --test-concurrency=1 FE/tests/*.test.ts BE/tests/*.test.ts tests/*.test.ts",
    "test:fe": "node --env-file=.env.local --import tsx --test FE/tests/*.test.ts",
    "test:be": "node --env-file=.env.local --import tsx --test --test-concurrency=1 BE/tests/*.test.ts",
    "test:integration": "node --env-file=.env.local --import tsx scripts/integration-test.ts",
    "test:rag": "node --env-file=.env.local --import tsx scripts/evaluate-rag.ts",
    "test:academic": "node --env-file=.env.local --import tsx scripts/evaluate-academic.ts",
    "test:support": "node --env-file=.env.local --import tsx scripts/evaluate-support.ts",
    "test:chat": "node --env-file=.env.local --import tsx scripts/evaluate-chat-quality.ts",
    "test:chat:evidence": "node --env-file=.env.local --import tsx scripts/evaluate-evidence-quality.ts",
    "test:chat:errors": "node --env-file=.env.local --import tsx scripts/evaluate-chat-errors.ts",
    "backup": "node --env-file=.env.local --import tsx scripts/backup.ts",
    "lint": "eslint",
    "typecheck": "next typegen FE && tsc --noEmit",
    "format": "prettier --write \"{src,FE,BE}/**/*.{ts,tsx,css,json}\" next.config.ts README.md",
    "format:check": "prettier --check \"{src,FE,BE}/**/*.{ts,tsx,css,json}\" next.config.ts README.md",
    "test:web": "node --env-file=.env.local --import tsx scripts/evaluate-global-web.ts",
    "backup:cloud": "node --env-file=.env.cloud.local --import tsx scripts/backup-cloud.ts",
    "test:cloud": "node scripts/handover/verify.mjs",
    "doctor": "node scripts/handover/doctor.mjs",
    "local": "node scripts/handover/local.mjs",
    "dev:local": "node scripts/handover/local.mjs --dev",
    "setup:local": "node --import tsx scripts/handover/restore-local.mjs",
    "verify:handover": "node scripts/handover/verify.mjs",
    "restore:cloud": "node --import tsx scripts/handover/restore-cloud.mjs",
    "deploy:vercel": "node scripts/handover/deploy.mjs",
    "export:handover": "node scripts/handover/export.mjs",
    "package:handover": "node scripts/handover/package.mjs",
    "setup:canonical": "node --env-file=.env.local --import tsx scripts/bootstrap.ts --index --publish-seed && node --env-file=.env.local --import tsx scripts/seed-faq.ts",
    "start:be": "node --env-file=.env.local --import tsx BE/server.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@huggingface/transformers": "4.3.1",
    "@mastra/core": "1.79.0",
    "@mastra/libsql": "1.27.0",
    "@mastra/pg": "1.32.0",
    "@mastra/rag": "2.7.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "0.1.80",
    "@types/yauzl": "^3.4.0",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.3",
    "@vercel/queue": "0.10.0",
    "better-auth": "1.7.12",
    "better-sqlite3": "13.0.3",
    "bootstrap": "^5.3.8",
    "cheerio": "1.2.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "onnxruntime-node": "1.30.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "engines": {
    "node": "24.x"
  }
}