{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/server/*": [
        "../BE/*"
      ],
      "@/features/*": [
        "./features/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}